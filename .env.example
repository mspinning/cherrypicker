# ---------- Postgres (CRM database, with pgvector) ----------
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=crm
POSTGRES_PORT=5432

# ---------- Keycloak database (created by docker/postgres/init.sh) ----------
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# ---------- Keycloak ----------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin
KEYCLOAK_PORT=8080
# URL under which Keycloak is reachable from the outside (= token issuer)
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=crm
KEYCLOAK_CLIENT_ID=crm-backend
KEYCLOAK_CLIENT_SECRET=change-me-client-secret

# ---------- Server ----------
NODE_ENV=development
SERVER_PORT=3000
# Auto-create tables from entities. Dev only - switch to migrations before production.
DB_SYNCHRONIZE=true

# ---------- Client (Caddy: Angular app + /api proxy) ----------
# ":80" = plain HTTP. A public domain (e.g. crm.example.com) makes Caddy fetch
# TLS certificates itself; ports 80 and 443 must then be reachable from outside.
SITE_ADDRESS=:80
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# ---------- Bifrost (LLM gateway) ----------
# Web UI + API on http://localhost:${BIFROST_PORT} (8080 is taken by Keycloak)
BIFROST_PORT=8081
BIFROST_LOG_LEVEL=info
# Provider keys, referenced in Bifrost's provider config as env.ANTHROPIC_API_KEY etc.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BIFROST_SETUP_TOKEN=
# Virtual key created in the Bifrost UI, used by the server for embeddings
BIFROST_VIRTUAL_KEY=

# ---------- Knowledge base (embeddings via Bifrost) ----------
# Bifrost model id. Local: "ollama pull bge-m3" -> ollama/bge-m3:latest (1024 dimensions).
# Use the name exactly as Ollama lists it, incl. ":latest" - a virtual key only allows listed names.
# Hosted: openai/text-embedding-3-small (1536) - then set EMBEDDING_DIMENSIONS=1536.
EMBEDDING_MODEL=ollama/bge-m3:latest
EMBEDDING_DIMENSIONS=1024
KNOWLEDGE_MAX_UPLOAD_MB=50
